   <bpmn:outgoing>VF05</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="V5" name="Create Pending reservation and VEN reference">
   <bpmn:incoming>VF06</bpmn:incoming>
   <bpmn:outgoing>VF07</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="V6" name="Issue Venue service queue ticket">
