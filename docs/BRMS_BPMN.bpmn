<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 id="Definitions_BRMS_MSIT" targetNamespace="https://sachie34.github.io/Birms/bpmn">
 <bpmn:collaboration id="Collaboration_BRMS">
  <bpmn:participant id="Participant_Documents" name="BRMS — Document Request and Certificate Issuance" processRef="Process_Documents"/>
  <bpmn:participant id="Participant_Blotter" name="BRMS — Resident Blotter Intake and Case Workflow" processRef="Process_Blotter"/>
  <bpmn:participant id="Participant_Venue" name="BRMS — Venue Reservation Request and Approval" processRef="Process_Venue"/>
  <bpmn:participant id="Participant_Queue" name="BRMS — Daily Service Queue Management" processRef="Process_Queue"/>
 </bpmn:collaboration>
 <bpmn:process id="Process_Documents" name="Document Request and Certificate Issuance" isExecutable="false">
  <bpmn:startEvent id="D_Start" name="Verified resident requests a document"/>
  <bpmn:task id="D_Identity" name="Resident identity verified at kiosk / QR"/>
  <bpmn:task id="D_Select" name="Select document type and enter purpose"/>
  <bpmn:task id="D_Save" name="Create Pending request and reference number"/>
  <bpmn:task id="D_Queue" name="Issue Documents queue ticket"/>
  <bpmn:task id="D_Review" name="Secretary reviews requirements"/>
  <bpmn:exclusiveGateway id="D_ReqGate" name="Requirements complete?" gatewayDirection="Diverging"/>
  <bpmn:task id="D_Incomplete" name="Record missing requirements and review note"/>
  <bpmn:task id="D_Decide" name="Staff makes final approval decision"/>
  <bpmn:exclusiveGateway id="D_ApproveGate" name="Approved?" gatewayDirection="Diverging"/>
  <bpmn:task id="D_Reject" name="Set Rejected and record reason"/>
  <bpmn:endEvent id="D_EndReject" name="Request rejected"/>
  <bpmn:task id="D_Ready" name="Set Approved / Ready and queue resident notice"/>
  <bpmn:task id="D_Check" name="Check fee, wording, resident data and signature requirement"/>
  <bpmn:exclusiveGateway id="D_IssueGate" name="All issue checks pass?" gatewayDirection="Diverging"/>
  <bpmn:task id="D_Fix" name="Correct missing setup or request data"/>
  <bpmn:task id="D_Issue" name="Create issuance snapshot and set Released"/>
  <bpmn:exclusiveGateway id="D_FeeGate" name="Fee greater than zero?" gatewayDirection="Diverging"/>
  <bpmn:task id="D_Ledger" name="Require O.R. and create pending cash-ledger row"/>
  <bpmn:task id="D_NoLedger" name="Skip cash ledger for zero fee"/>
  <bpmn:task id="D_Print" name="Print or download certificate PDF"/>
  <bpmn:endEvent id="D_End" name="Certificate issued and recorded"/>
  <bpmn:sequenceFlow id="DF01" sourceRef="D_Start" targetRef="D_Identity"/>
  <bpmn:sequenceFlow id="DF02" sourceRef="D_Identity" targetRef="D_Select"/>
  <bpmn:sequenceFlow id="DF03" sourceRef="D_Select" targetRef="D_Save"/>
  <bpmn:sequenceFlow id="DF04" sourceRef="D_Save" targetRef="D_Queue"/>
  <bpmn:sequenceFlow id="DF05" sourceRef="D_Queue" targetRef="D_Review"/>
  <bpmn:sequenceFlow id="DF06" sourceRef="D_Review" targetRef="D_ReqGate"/>
  <bpmn:sequenceFlow id="DF07" sourceRef="D_ReqGate" targetRef="D_Incomplete" name="No"/>
  <bpmn:sequenceFlow id="DF08" sourceRef="D_Incomplete" targetRef="D_Review"/>
  <bpmn:sequenceFlow id="DF09" sourceRef="D_ReqGate" targetRef="D_Decide" name="Yes"/>
  <bpmn:sequenceFlow id="DF10" sourceRef="D_Decide" targetRef="D_ApproveGate"/>
  <bpmn:sequenceFlow id="DF11" sourceRef="D_ApproveGate" targetRef="D_Reject" name="No"/>
  <bpmn:sequenceFlow id="DF12" sourceRef="D_Reject" targetRef="D_EndReject"/>
  <bpmn:sequenceFlow id="DF13" sourceRef="D_ApproveGate" targetRef="D_Ready" name="Yes"/>
  <bpmn:sequenceFlow id="DF14" sourceRef="D_Ready" targetRef="D_Check"/>
  <bpmn:sequenceFlow id="DF15" sourceRef="D_Check" targetRef="D_IssueGate"/>
  <bpmn:sequenceFlow id="DF16" sourceRef="D_IssueGate" targetRef="D_Fix" name="No"/>
  <bpmn:sequenceFlow id="DF17" sourceRef="D_Fix" targetRef="D_Check"/>
  <bpmn:sequenceFlow id="DF18" sourceRef="D_IssueGate" targetRef="D_Issue" name="Yes"/>
  <bpmn:sequenceFlow id="DF19" sourceRef="D_Issue" targetRef="D_FeeGate"/>
  <bpmn:sequenceFlow id="DF20" sourceRef="D_FeeGate" targetRef="D_Ledger" name="Yes"/>
  <bpmn:sequenceFlow id="DF21" sourceRef="D_FeeGate" targetRef="D_NoLedger" name="No"/>
  <bpmn:sequenceFlow id="DF22" sourceRef="D_Ledger" targetRef="D_Print"/>
  <bpmn:sequenceFlow id="DF23" sourceRef="D_NoLedger" targetRef="D_Print"/>
  <bpmn:sequenceFlow id="DF24" sourceRef="D_Print" targetRef="D_End"/>
 </bpmn:process>
 <bpmn:process id="Process_Blotter" name="Resident Blotter Intake and Case Workflow" isExecutable="false">
  <bpmn:startEvent id="B_Start" name="Resident submits incident report"/>
  <bpmn:task id="B_Verify" name="Verify active resident kiosk session"/>
  <bpmn:task id="B_Submit" name="Enter incident details and optional respondent"/>
  <bpmn:task id="B_Save" name="Save resident blotter request and issue Blotter queue ticket"/>
  <bpmn:task id="B_Review" name="Staff/Admin reviews resident report"/>
  <bpmn:exclusiveGateway id="B_AcceptGate" name="Accept report?" gatewayDirection="Diverging"/>
  <bpmn:task id="B_Reject" name="Reject report with reason; set Dismissed"/>
  <bpmn:endEvent id="B_EndReject" name="Dismissed intake retained"/>
  <bpmn:task id="B_Create" name="Create official blotter case and party records"/>
  <bpmn:task id="B_Status" name="Maintain Ongoing / Unresolved case status"/>
  <bpmn:exclusiveGateway id="B_HearingGate" name="Schedule or record a hearing?" gatewayDirection="Diverging"/>
  <bpmn:task id="B_Schedule" name="Schedule hearing for Ongoing / Unresolved case"/>
  <bpmn:task id="B_Outcome" name="Record Held / Postponed / Cancelled outcome"/>
  <bpmn:exclusiveGateway id="B_CloseGate" name="Resolve or dismiss case?" gatewayDirection="Diverging"/>
  <bpmn:task id="B_CheckHearings" name="Confirm no Scheduled hearings; enter resolution/dismissal reason"/>
  <bpmn:exclusiveGateway id="B_ArchiveGate" name="Archive closed case now?" gatewayDirection="Diverging"/>
  <bpmn:task id="B_Archive" name="Archive Resolved / Dismissed case"/>
  <bpmn:task id="B_Notify" name="Update shared status history and notify resident"/>
  <bpmn:endEvent id="B_End" name="Case workflow saved"/>
  <bpmn:sequenceFlow id="BF01" sourceRef="B_Start" targetRef="B_Verify"/>
  <bpmn:sequenceFlow id="BF02" sourceRef="B_Verify" targetRef="B_Submit"/>
  <bpmn:sequenceFlow id="BF03" sourceRef="B_Submit" targetRef="B_Save"/>
  <bpmn:sequenceFlow id="BF04" sourceRef="B_Save" targetRef="B_Review"/>
  <bpmn:sequenceFlow id="BF05" sourceRef="B_Review" targetRef="B_AcceptGate"/>
  <bpmn:sequenceFlow id="BF06" sourceRef="B_AcceptGate" targetRef="B_Reject" name="No"/>
  <bpmn:sequenceFlow id="BF07" sourceRef="B_Reject" targetRef="B_EndReject"/>
  <bpmn:sequenceFlow id="BF08" sourceRef="B_AcceptGate" targetRef="B_Create" name="Yes"/>
  <bpmn:sequenceFlow id="BF09" sourceRef="B_Create" targetRef="B_Status"/>
  <bpmn:sequenceFlow id="BF10" sourceRef="B_Status" targetRef="B_HearingGate"/>
  <bpmn:sequenceFlow id="BF11" sourceRef="B_HearingGate" targetRef="B_Schedule" name="Yes"/>
  <bpmn:sequenceFlow id="BF12" sourceRef="B_Schedule" targetRef="B_Outcome"/>
  <bpmn:sequenceFlow id="BF13" sourceRef="B_Outcome" targetRef="B_Status"/>
  <bpmn:sequenceFlow id="BF14" sourceRef="B_HearingGate" targetRef="B_CloseGate" name="No"/>
  <bpmn:sequenceFlow id="BF15" sourceRef="B_CloseGate" targetRef="B_Status" name="No"/>
  <bpmn:sequenceFlow id="BF16" sourceRef="B_CloseGate" targetRef="B_CheckHearings" name="Yes"/>
  <bpmn:sequenceFlow id="BF17" sourceRef="B_CheckHearings" targetRef="B_ArchiveGate"/>
  <bpmn:sequenceFlow id="BF18" sourceRef="B_ArchiveGate" targetRef="B_Archive" name="Yes"/>
  <bpmn:sequenceFlow id="BF19" sourceRef="B_ArchiveGate" targetRef="B_Notify" name="No"/>
  <bpmn:sequenceFlow id="BF20" sourceRef="B_Archive" targetRef="B_Notify"/>
  <bpmn:sequenceFlow id="BF21" sourceRef="B_Notify" targetRef="B_End"/>
 </bpmn:process>
 <bpmn:process id="Process_Venue" name="Venue Reservation Request and Approval" isExecutable="false">
  <bpmn:startEvent id="V_Start" name="Verified resident requests a venue"/>
  <bpmn:task id="V_Select" name="Choose venue, purpose, date and time range"/>
  <bpmn:task id="V_Validate" name="Validate resident, venue and time range"/>
  <bpmn:exclusiveGateway id="V_OverlapGate" name="Pending / Approved slot overlap?" gatewayDirection="Diverging"/>
  <bpmn:task id="V_Change" name="Ask resident to choose another time"/>
  <bpmn:task id="V_Create" name="Create Pending reservation and reference"/>
  <bpmn:task id="V_Queue" name="Issue Venue queue ticket"/>
  <bpmn:task id="V_Review" name="Staff reviews reservation"/>
  <bpmn:exclusiveGateway id="V_ApproveGate" name="Approve reservation?" gatewayDirection="Diverging"/>
  <bpmn:task id="V_Reject" name="Set Rejected and save reason"/>
  <bpmn:task id="V_RejectNotice" name="Write status history and queue resident notice"/>
  <bpmn:endEvent id="V_EndReject" name="Reservation rejected"/>
  <bpmn:task id="V_Lock" name="Lock venue and recheck overlapping slots"/>
  <bpmn:exclusiveGateway id="V_FreeGate" name="Slot still available?" gatewayDirection="Diverging"/>
  <bpmn:task id="V_Conflict" name="Do not approve; return conflict message"/>
  <bpmn:task id="V_Approve" name="Set Approved and notify resident"/>
  <bpmn:task id="V_Complete" name="After booking, set Completed"/>
  <bpmn:task id="V_Notify" name="Record final status history and notification"/>
  <bpmn:endEvent id="V_End" name="Reservation workflow complete"/>
  <bpmn:sequenceFlow id="VF01" sourceRef="V_Start" targetRef="V_Select"/>
  <bpmn:sequenceFlow id="VF02" sourceRef="V_Select" targetRef="V_Validate"/>
  <bpmn:sequenceFlow id="VF03" sourceRef="V_Validate" targetRef="V_OverlapGate"/>
  <bpmn:sequenceFlow id="VF04" sourceRef="V_OverlapGate" targetRef="V_Change" name="Yes"/>
  <bpmn:sequenceFlow id="VF05" sourceRef="V_Change" targetRef="V_Select"/>
  <bpmn:sequenceFlow id="VF06" sourceRef="V_OverlapGate" targetRef="V_Create" name="No"/>
  <bpmn:sequenceFlow id="VF07" sourceRef="V_Create" targetRef="V_Queue"/>
  <bpmn:sequenceFlow id="VF08" sourceRef="V_Queue" targetRef="V_Review"/>
  <bpmn:sequenceFlow id="VF09" sourceRef="V_Review" targetRef="V_ApproveGate"/>
  <bpmn:sequenceFlow id="VF10" sourceRef="V_ApproveGate" targetRef="V_Reject" name="No"/>
  <bpmn:sequenceFlow id="VF11" sourceRef="V_Reject" targetRef="V_RejectNotice"/>
  <bpmn:sequenceFlow id="VF12" sourceRef="V_RejectNotice" targetRef="V_EndReject"/>
  <bpmn:sequenceFlow id="VF13" sourceRef="V_ApproveGate" targetRef="V_Lock" name="Yes"/>
  <bpmn:sequenceFlow id="VF14" sourceRef="V_Lock" targetRef="V_FreeGate"/>
  <bpmn:sequenceFlow id="VF15" sourceRef="V_FreeGate" targetRef="V_Conflict" name="No"/>
  <bpmn:sequenceFlow id="VF16" sourceRef="V_Conflict" targetRef="V_RejectNotice"/>
  <bpmn:sequenceFlow id="VF17" sourceRef="V_FreeGate" targetRef="V_Approve" name="Yes"/>
  <bpmn:sequenceFlow id="VF18" sourceRef="V_Approve" targetRef="V_Complete"/>
  <bpmn:sequenceFlow id="VF19" sourceRef="V_Complete" targetRef="V_Notify"/>
  <bpmn:sequenceFlow id="VF20" sourceRef="V_Notify" targetRef="V_End"/>
 </bpmn:process>
 <bpmn:process id="Process_Queue" name="Daily Service Queue Management" isExecutable="false">
  <bpmn:startEvent id="Q_Start" name="Resident or Staff requests queue ticket"/>
  <bpmn:task id="Q_Service" name="Choose Blotter, Documents or Venue"/>
  <bpmn:task id="Q_Issue" name="Lock daily counter and assign next service number"/>
  <bpmn:task id="Q_Waiting" name="Save queue entry as Waiting and show ticket"/>
  <bpmn:task id="Q_Call" name="Staff calls next Waiting number"/>
  <bpmn:exclusiveGateway id="Q_Gate" name="A number is already Called?" gatewayDirection="Diverging"/>
  <bpmn:task id="Q_FinishCurrent" name="Serve, skip or cancel current Called entry first"/>
  <bpmn:task id="Q_Called" name="Set next entry Called and update public display"/>
  <bpmn:exclusiveGateway id="Q_Outcome" name="Queue outcome?" gatewayDirection="Diverging"/>
  <bpmn:task id="Q_Served" name="Mark Served and record time / staff"/>
  <bpmn:task id="Q_Skipped" name="Mark Skipped"/>
  <bpmn:task id="Q_Cancelled" name="Mark Cancelled"/>
  <bpmn:task id="Q_Refresh" name="Refresh current number and waiting count"/>
  <bpmn:task id="Q_Notify" name="Queue email/SMS notice according to preference"/>
  <bpmn:endEvent id="Q_End" name="Queue cycle updated"/>
  <bpmn:sequenceFlow id="QF01" sourceRef="Q_Start" targetRef="Q_Service"/>
  <bpmn:sequenceFlow id="QF02" sourceRef="Q_Service" targetRef="Q_Issue"/>
  <bpmn:sequenceFlow id="QF03" sourceRef="Q_Issue" targetRef="Q_Waiting"/>
  <bpmn:sequenceFlow id="QF04" sourceRef="Q_Waiting" targetRef="Q_Call"/>
  <bpmn:sequenceFlow id="QF05" sourceRef="Q_Call" targetRef="Q_Gate"/>
  <bpmn:sequenceFlow id="QF06" sourceRef="Q_Gate" targetRef="Q_FinishCurrent" name="Yes"/>
  <bpmn:sequenceFlow id="QF07" sourceRef="Q_FinishCurrent" targetRef="Q_Call"/>
  <bpmn:sequenceFlow id="QF08" sourceRef="Q_Gate" targetRef="Q_Called" name="No"/>
  <bpmn:sequenceFlow id="QF09" sourceRef="Q_Called" targetRef="Q_Outcome"/>
  <bpmn:sequenceFlow id="QF10" sourceRef="Q_Outcome" targetRef="Q_Served" name="Served"/>
  <bpmn:sequenceFlow id="QF11" sourceRef="Q_Outcome" targetRef="Q_Skipped" name="Skip"/>
  <bpmn:sequenceFlow id="QF12" sourceRef="Q_Outcome" targetRef="Q_Cancelled" name="Cancel"/>
  <bpmn:sequenceFlow id="QF13" sourceRef="Q_Served" targetRef="Q_Refresh"/>
  <bpmn:sequenceFlow id="QF14" sourceRef="Q_Skipped" targetRef="Q_Refresh"/>
  <bpmn:sequenceFlow id="QF15" sourceRef="Q_Cancelled" targetRef="Q_Refresh"/>
  <bpmn:sequenceFlow id="QF16" sourceRef="Q_Refresh" targetRef="Q_Notify"/>
  <bpmn:sequenceFlow id="QF17" sourceRef="Q_Notify" targetRef="Q_End"/>
 </bpmn:process>
 <bpmndi:BPMNDiagram id="Diagram_Documents"><bpmndi:BPMNPlane id="Plane_Documents" bpmnElement="Collaboration_BRMS">
  <bpmndi:BPMNShape id="Shape_Participant_Documents" bpmnElement="Participant_Documents" isHorizontal="true"><dc:Bounds x="70" y="70" width="2946" height="430"/></bpmndi:BPMNShape>
