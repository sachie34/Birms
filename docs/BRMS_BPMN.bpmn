  <bpmn:exclusiveGateway id="Q9" name="Outcome for current number?" gatewayDirection="Diverging">
   <bpmn:incoming>Q10</bpmn:incoming>
   <bpmn:outgoing>Q11</bpmn:outgoing>
   <bpmn:outgoing>Q12</bpmn:outgoing>
   <bpmn:outgoing>Q13</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="Q10" name="Mark Served and record time/staff">
   <bpmn:incoming>Q11</bpmn:incoming>
   <bpmn:outgoing>Q14</bpmn:outgoing>
