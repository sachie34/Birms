 <bpmn:process id="Process_Queue" name="Three Separate Daily Service Queues" isExecutable="false">
  <bpmn:startEvent id="Q0" name="Resident or Staff requests a queue ticket">
   <bpmn:outgoing>QF01</bpmn:outgoing>
  </bpmn:startEvent>
  <bpmn:task id="Q1" name="Choose Blotter, Documents or Venue">
   <bpmn:incoming>QF01</bpmn:incoming>
   <bpmn:outgoing>QF02</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="Q2" name="Lock daily service counter and assign next number">
   <bpmn:incoming>QF02</bpmn:incoming>
   <bpmn:outgoing>QF03</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="Q3" name="Save queue entry as Waiting and show ticket">
   <bpmn:incoming>QF03</bpmn:incoming>
   <bpmn:outgoing>QF04</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="Q4" name="Enqueue email/SMS notice according to resident preference">
   <bpmn:incoming>QF04</bpmn:incoming>
   <bpmn:outgoing>QF05</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="Q4J" name="Continue to call-next action" gatewayDirection="Converging">
   <bpmn:incoming>QF05</bpmn:incoming>
   <bpmn:incoming>QF06</bpmn:incoming>
   <bpmn:outgoing>QF07</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="Q5" name="Staff selects Call Next for the service">
   <bpmn:incoming>QF07</bpmn:incoming>
   <bpmn:outgoing>QF08</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="Q6" name="Is another number still Called?" gatewayDirection="Diverging">
   <bpmn:incoming>QF08</bpmn:incoming>
   <bpmn:outgoing>QF09</bpmn:outgoing>
   <bpmn:outgoing>QF10</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="Q7" name="Serve, skip or cancel current Called number first">
   <bpmn:incoming>QF09</bpmn:incoming>
   <bpmn:outgoing>QF06</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="Q8" name="Set next Waiting entry to Called and update public display">
   <bpmn:incoming>QF10</bpmn:incoming>
   <bpmn:outgoing>QF11</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="Q9" name="Outcome for current number?" gatewayDirection="Diverging">
   <bpmn:incoming>QF11</bpmn:incoming>
   <bpmn:outgoing>QF12</bpmn:outgoing>
   <bpmn:outgoing>QF13</bpmn:outgoing>
   <bpmn:outgoing>QF14</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="Q10" name="Mark Served and record time/staff">
   <bpmn:incoming>QF12</bpmn:incoming>
   <bpmn:outgoing>QF15</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="Q11" name="Mark Skipped">
