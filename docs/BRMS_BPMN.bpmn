   <bpmn:incoming>QF14</bpmn:incoming>
   <bpmn:outgoing>QF17</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="Q13" name="Queue action complete" gatewayDirection="Converging">
   <bpmn:incoming>QF15</bpmn:incoming>
   <bpmn:incoming>QF16</bpmn:incoming>
   <bpmn:incoming>QF17</bpmn:incoming>
   <bpmn:outgoing>QF18</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="Q14" name="Refresh Now Serving and waiting count; public display auto-refreshes">
