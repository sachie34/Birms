 <bpmn:process id="Process_Venue" name="Venue Reservation and Approval Workflow" isExecutable="false">
  <bpmn:startEvent id="V0" name="Verified resident or Staff requests a venue">
   <bpmn:outgoing>VF01</bpmn:outgoing>
  </bpmn:startEvent>
