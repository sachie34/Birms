   <bpmn:outgoing>S09</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:endEvent id="S8" name="Status lookup complete; resident personal details are not displayed">
   <bpmn:incoming>S09</bpmn:incoming>
  </bpmn:endEvent>
