 <bpmn:process id="Process_Status" name="Unified Request Status Lookup" isExecutable="false">
  <bpmn:startEvent id="S0" name="Resident wants to check request status">
   <bpmn:outgoing>S01</bpmn:outgoing>
  </bpmn:startEvent>
  <bpmn:task id="S1" name="Enter the printed request reference">
   <bpmn:incoming>S01</bpmn:incoming>
   <bpmn:outgoing>S02</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="S2" name="Apply lookup rate limit and validate reference format">
   <bpmn:incoming>S02</bpmn:incoming>
   <bpmn:outgoing>S03</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="S3" name="Search document, venue, resident blotter request and official case records">
   <bpmn:incoming>S03</bpmn:incoming>
   <bpmn:outgoing>S04</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="S4" name="Matching reference found?" gatewayDirection="Diverging">
   <bpmn:incoming>S04</bpmn:incoming>
   <bpmn:outgoing>S05</bpmn:outgoing>
   <bpmn:outgoing>S06</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="S5" name="Show service, reference, public status, submitted time and status history">
