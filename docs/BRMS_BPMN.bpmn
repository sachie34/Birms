   <bpmn:incoming>Q14</bpmn:incoming>
   <bpmn:incoming>Q15</bpmn:incoming>
   <bpmn:incoming>Q16</bpmn:incoming>
   <bpmn:outgoing>Q17</bpmn:outgoing>
  </bpmn:exclusiveGateway>
