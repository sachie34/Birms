<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_BRMS_MsitSrs" targetNamespace="https://sachie34.github.io/Birms/bpmn">
 <bpmn:collaboration id="Collaboration_BRMS">
  <bpmn:participant id="Participant_Resident" name="BRMS — Resident Record Registration and Maintenance" processRef="Process_Resident"/>
  <bpmn:participant id="Participant_Kiosk" name="BRMS — Resident Kiosk Identity Verification" processRef="Process_Kiosk"/>
  <bpmn:participant id="Participant_Documents" name="BRMS — Document Request and Certificate Issuance" processRef="Process_Documents"/>
  <bpmn:participant id="Participant_Blotter" name="BRMS — Resident Blotter Intake, Official Case and Hearing Workflow" processRef="Process_Blotter"/>
  <bpmn:participant id="Participant_Venue" name="BRMS — Venue Reservation and Approval Workflow" processRef="Process_Venue"/>
  <bpmn:participant id="Participant_Queue" name="BRMS — Three Separate Daily Service Queues" processRef="Process_Queue"/>
  <bpmn:participant id="Participant_Status" name="BRMS — Unified Request Status Lookup" processRef="Process_Status"/>
 </bpmn:collaboration>
 <bpmn:process id="Process_Resident" name="Resident Record Registration and Maintenance" isExecutable="false">
  <bpmn:startEvent id="R0" name="Admin opens Residents">
   <bpmn:outgoing>RF01</bpmn:outgoing>
  </bpmn:startEvent>
  <bpmn:task id="R1" name="Register a new resident or open an existing record">
   <bpmn:incoming>RF01</bpmn:incoming>
   <bpmn:outgoing>RF02</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="R2" name="Enter personal details, individual address, Purok, status, type, contacts, photo and notification preference">
   <bpmn:incoming>RF02</bpmn:incoming>
   <bpmn:outgoing>RF03</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="R3" name="Validate required fields, lookup values and identity details">
   <bpmn:incoming>RF03</bpmn:incoming>
   <bpmn:outgoing>RF04</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="R4" name="Possible duplicate name and birthdate?" gatewayDirection="Diverging">
   <bpmn:incoming>RF04</bpmn:incoming>
   <bpmn:outgoing>RF05</bpmn:outgoing>
   <bpmn:outgoing>RF08</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="R5" name="Display the possible matching resident record">
   <bpmn:incoming>RF05</bpmn:incoming>
   <bpmn:outgoing>RF06</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="R6" name="Admin confirms the record is a different person">
   <bpmn:incoming>RF06</bpmn:incoming>
   <bpmn:outgoing>RF07</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="R7" name="Continue to save" gatewayDirection="Converging">
   <bpmn:incoming>RF07</bpmn:incoming>
   <bpmn:incoming>RF08</bpmn:incoming>
   <bpmn:outgoing>RF09</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="R8" name="Save resident and assign unique Resident ID">
   <bpmn:incoming>RF09</bpmn:incoming>
   <bpmn:outgoing>RF10</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="R9" name="Archive or restore this record?" gatewayDirection="Diverging">
   <bpmn:incoming>RF10</bpmn:incoming>
   <bpmn:outgoing>RF11</bpmn:outgoing>
   <bpmn:outgoing>RF13</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="R10" name="Admin archives or restores record; no hard delete">
   <bpmn:incoming>RF11</bpmn:incoming>
   <bpmn:outgoing>RF12</bpmn:outgoing>
  </bpmn:task>
  <bpmn:endEvent id="R11" name="Resident record retained">
   <bpmn:incoming>RF12</bpmn:incoming>
   <bpmn:incoming>RF13</bpmn:incoming>
  </bpmn:endEvent>
  <bpmn:sequenceFlow id="RF01" sourceRef="R0" targetRef="R1"/>
  <bpmn:sequenceFlow id="RF02" sourceRef="R1" targetRef="R2"/>
  <bpmn:sequenceFlow id="RF03" sourceRef="R2" targetRef="R3"/>
  <bpmn:sequenceFlow id="RF04" sourceRef="R3" targetRef="R4"/>
  <bpmn:sequenceFlow id="RF05" sourceRef="R4" targetRef="R5" name="Yes"/>
  <bpmn:sequenceFlow id="RF06" sourceRef="R5" targetRef="R6"/>
  <bpmn:sequenceFlow id="RF07" sourceRef="R6" targetRef="R7"/>
  <bpmn:sequenceFlow id="RF08" sourceRef="R4" targetRef="R7" name="No"/>
  <bpmn:sequenceFlow id="RF09" sourceRef="R7" targetRef="R8"/>
  <bpmn:sequenceFlow id="RF10" sourceRef="R8" targetRef="R9"/>
  <bpmn:sequenceFlow id="RF11" sourceRef="R9" targetRef="R10" name="Yes"/>
  <bpmn:sequenceFlow id="RF12" sourceRef="R10" targetRef="R11"/>
  <bpmn:sequenceFlow id="RF13" sourceRef="R9" targetRef="R11" name="No"/>
 </bpmn:process>
 <bpmn:process id="Process_Kiosk" name="Resident Kiosk Identity Verification" isExecutable="false">
  <bpmn:startEvent id="K0" name="Resident opens kiosk or QR request link">
   <bpmn:outgoing>KF01</bpmn:outgoing>
  </bpmn:startEvent>
  <bpmn:task id="K1" name="Enter Resident ID and birthdate, or name and birthdate">
   <bpmn:incoming>KF01</bpmn:incoming>
   <bpmn:outgoing>KF02</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="K2" name="Which identity method?" gatewayDirection="Diverging">
   <bpmn:incoming>KF02</bpmn:incoming>
   <bpmn:outgoing>KF03</bpmn:outgoing>
   <bpmn:outgoing>KF07</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="K3" name="Match Resident ID and birthdate to one active resident">
   <bpmn:incoming>KF03</bpmn:incoming>
   <bpmn:outgoing>KF04</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="K4" name="Exactly one active match?" gatewayDirection="Diverging">
   <bpmn:incoming>KF04</bpmn:incoming>
   <bpmn:outgoing>KF05</bpmn:outgoing>
   <bpmn:outgoing>KF06</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="K5" name="Match first name, last name and birthdate">
   <bpmn:incoming>KF07</bpmn:incoming>
   <bpmn:outgoing>KF08</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="K6" name="Exactly one active match?" gatewayDirection="Diverging">
   <bpmn:incoming>KF08</bpmn:incoming>
   <bpmn:outgoing>KF09</bpmn:outgoing>
   <bpmn:outgoing>KF10</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="K7" name="Send one-time code to registered email or SMS when provider is configured">
   <bpmn:incoming>KF09</bpmn:incoming>
   <bpmn:outgoing>KF11</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="K8" name="Resident enters six-digit verification code">
   <bpmn:incoming>KF11</bpmn:incoming>
   <bpmn:outgoing>KF12</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="K9" name="Code valid, unused, unexpired and within attempt limit?" gatewayDirection="Diverging">
   <bpmn:incoming>KF12</bpmn:incoming>
   <bpmn:outgoing>KF13</bpmn:outgoing>
   <bpmn:outgoing>KF14</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:exclusiveGateway id="K10" name="Identity verified" gatewayDirection="Converging">
   <bpmn:incoming>KF05</bpmn:incoming>
   <bpmn:incoming>KF13</bpmn:incoming>
   <bpmn:outgoing>KF15</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="K11" name="Create resident-only kiosk session with 90-second idle timeout">
   <bpmn:incoming>KF15</bpmn:incoming>
   <bpmn:outgoing>KF16</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="K12" name="Display resident service menu">
   <bpmn:incoming>KF16</bpmn:incoming>
   <bpmn:outgoing>KF17</bpmn:outgoing>
  </bpmn:task>
  <bpmn:endEvent id="K13" name="Resident can select a service">
   <bpmn:incoming>KF17</bpmn:incoming>
  </bpmn:endEvent>
  <bpmn:exclusiveGateway id="K14" name="Verification failed" gatewayDirection="Converging">
   <bpmn:incoming>KF06</bpmn:incoming>
   <bpmn:incoming>KF10</bpmn:incoming>
   <bpmn:incoming>KF14</bpmn:incoming>
   <bpmn:outgoing>KF18</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="K15" name="Show verification error and direct resident to Staff">
   <bpmn:incoming>KF18</bpmn:incoming>
   <bpmn:outgoing>KF19</bpmn:outgoing>
  </bpmn:task>
  <bpmn:endEvent id="K16" name="Counter assistance required">
   <bpmn:incoming>KF19</bpmn:incoming>
  </bpmn:endEvent>
  <bpmn:sequenceFlow id="KF01" sourceRef="K0" targetRef="K1"/>
  <bpmn:sequenceFlow id="KF02" sourceRef="K1" targetRef="K2"/>
  <bpmn:sequenceFlow id="KF03" sourceRef="K2" targetRef="K3" name="Resident ID"/>
  <bpmn:sequenceFlow id="KF04" sourceRef="K3" targetRef="K4"/>
  <bpmn:sequenceFlow id="KF05" sourceRef="K4" targetRef="K10" name="Yes"/>
  <bpmn:sequenceFlow id="KF06" sourceRef="K4" targetRef="K14" name="No"/>
  <bpmn:sequenceFlow id="KF07" sourceRef="K2" targetRef="K5" name="Name fallback"/>
  <bpmn:sequenceFlow id="KF08" sourceRef="K5" targetRef="K6"/>
  <bpmn:sequenceFlow id="KF09" sourceRef="K6" targetRef="K7" name="Yes"/>
  <bpmn:sequenceFlow id="KF10" sourceRef="K6" targetRef="K14" name="No / multiple"/>
  <bpmn:sequenceFlow id="KF11" sourceRef="K7" targetRef="K8"/>
  <bpmn:sequenceFlow id="KF12" sourceRef="K8" targetRef="K9"/>
  <bpmn:sequenceFlow id="KF13" sourceRef="K9" targetRef="K10" name="Yes"/>
  <bpmn:sequenceFlow id="KF14" sourceRef="K9" targetRef="K14" name="No"/>
  <bpmn:sequenceFlow id="KF15" sourceRef="K10" targetRef="K11"/>
  <bpmn:sequenceFlow id="KF16" sourceRef="K11" targetRef="K12"/>
  <bpmn:sequenceFlow id="KF17" sourceRef="K12" targetRef="K13"/>
  <bpmn:sequenceFlow id="KF18" sourceRef="K14" targetRef="K15"/>
  <bpmn:sequenceFlow id="KF19" sourceRef="K15" targetRef="K16"/>
 </bpmn:process>
 <bpmn:process id="Process_Documents" name="Document Request and Certificate Issuance" isExecutable="false">
  <bpmn:startEvent id="D0" name="Resident needs a barangay document">
   <bpmn:outgoing>DF01</bpmn:outgoing>
  </bpmn:startEvent>
  <bpmn:task id="D1" name="Resident kiosk request or Staff counter intake">
   <bpmn:incoming>DF01</bpmn:incoming>
   <bpmn:outgoing>DF02</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="D2" name="Select document type and enter purpose">
   <bpmn:incoming>DF02</bpmn:incoming>
   <bpmn:outgoing>DF03</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="D3" name="Create request reference; internal Pending and SRS Pending">
   <bpmn:incoming>DF03</bpmn:incoming>
   <bpmn:outgoing>DF04</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="D4" name="Issue Documents service queue ticket">
   <bpmn:incoming>DF04</bpmn:incoming>
   <bpmn:outgoing>DF05</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="D4J" name="Enter requirements review" gatewayDirection="Converging">
   <bpmn:incoming>DF05</bpmn:incoming>
   <bpmn:incoming>DF06</bpmn:incoming>
   <bpmn:outgoing>DF07</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="D5" name="Secretary or Admin reviews request requirements">
   <bpmn:incoming>DF07</bpmn:incoming>
   <bpmn:outgoing>DF08</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="D6" name="Requirements Complete?" gatewayDirection="Diverging">
   <bpmn:incoming>DF08</bpmn:incoming>
   <bpmn:outgoing>DF09</bpmn:outgoing>
   <bpmn:outgoing>DF10</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="D7" name="Record incomplete requirements and review note">
   <bpmn:incoming>DF09</bpmn:incoming>
   <bpmn:outgoing>DF06</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="D8" name="Staff or Admin makes final request decision">
   <bpmn:incoming>DF10</bpmn:incoming>
   <bpmn:outgoing>DF11</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="D9" name="Approve request?" gatewayDirection="Diverging">
   <bpmn:incoming>DF11</bpmn:incoming>
   <bpmn:outgoing>DF12</bpmn:outgoing>
   <bpmn:outgoing>DF15</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="D10" name="Set Rejected; record reason and status history">
   <bpmn:incoming>DF12</bpmn:incoming>
   <bpmn:outgoing>DF13</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="D11" name="Queue resident status notification">
   <bpmn:incoming>DF13</bpmn:incoming>
   <bpmn:outgoing>DF14</bpmn:outgoing>
  </bpmn:task>
  <bpmn:endEvent id="D12" name="Request rejected">
   <bpmn:incoming>DF14</bpmn:incoming>
  </bpmn:endEvent>
  <bpmn:task id="D13" name="Set internal Ready and SRS Approved; record history">
   <bpmn:incoming>DF15</bpmn:incoming>
   <bpmn:outgoing>DF16</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="D14" name="Queue email/SMS status notice using resident preference">
   <bpmn:incoming>DF16</bpmn:incoming>
   <bpmn:outgoing>DF17</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="D14J" name="Enter issuance checks" gatewayDirection="Converging">
   <bpmn:incoming>DF17</bpmn:incoming>
   <bpmn:incoming>DF18</bpmn:incoming>
   <bpmn:outgoing>DF19</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="D15" name="Check active resident, requirements, fee, wording and required Chairman signature image">
   <bpmn:incoming>DF19</bpmn:incoming>
   <bpmn:outgoing>DF20</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="D16" name="All issuance checks pass?" gatewayDirection="Diverging">
   <bpmn:incoming>DF20</bpmn:incoming>
   <bpmn:outgoing>DF21</bpmn:outgoing>
   <bpmn:outgoing>DF22</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="D17" name="Admin fixes missing setup or required resident/request data">
   <bpmn:incoming>DF21</bpmn:incoming>
   <bpmn:outgoing>DF18</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="D18" name="Staff/Admin creates issuance snapshot and sets SRS Released">
   <bpmn:incoming>DF22</bpmn:incoming>
   <bpmn:outgoing>DF23</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="D19" name="Fee greater than zero?" gatewayDirection="Diverging">
   <bpmn:incoming>DF23</bpmn:incoming>
   <bpmn:outgoing>DF24</bpmn:outgoing>
   <bpmn:outgoing>DF25</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="D20" name="Require O.R. and create pending cash-ledger row">
   <bpmn:incoming>DF24</bpmn:incoming>
   <bpmn:outgoing>DF26</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="D21" name="No cash-ledger row for zero-fee issuance">
   <bpmn:incoming>DF25</bpmn:incoming>
   <bpmn:outgoing>DF27</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="D22" name="Continue to certificate output" gatewayDirection="Converging">
   <bpmn:incoming>DF26</bpmn:incoming>
   <bpmn:incoming>DF27</bpmn:incoming>
   <bpmn:outgoing>DF28</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="D23" name="Print or download certificate PDF; record print action">
   <bpmn:incoming>DF28</bpmn:incoming>
   <bpmn:outgoing>DF29</bpmn:outgoing>
  </bpmn:task>
  <bpmn:endEvent id="D24" name="Issuance saved in history">
   <bpmn:incoming>DF29</bpmn:incoming>
  </bpmn:endEvent>
  <bpmn:sequenceFlow id="DF01" sourceRef="D0" targetRef="D1"/>
  <bpmn:sequenceFlow id="DF02" sourceRef="D1" targetRef="D2"/>
  <bpmn:sequenceFlow id="DF03" sourceRef="D2" targetRef="D3"/>
  <bpmn:sequenceFlow id="DF04" sourceRef="D3" targetRef="D4"/>
  <bpmn:sequenceFlow id="DF05" sourceRef="D4" targetRef="D4J"/>
  <bpmn:sequenceFlow id="DF06" sourceRef="D7" targetRef="D4J"/>
  <bpmn:sequenceFlow id="DF07" sourceRef="D4J" targetRef="D5"/>
  <bpmn:sequenceFlow id="DF08" sourceRef="D5" targetRef="D6"/>
  <bpmn:sequenceFlow id="DF09" sourceRef="D6" targetRef="D7" name="No"/>
  <bpmn:sequenceFlow id="DF10" sourceRef="D6" targetRef="D8" name="Yes"/>
  <bpmn:sequenceFlow id="DF11" sourceRef="D8" targetRef="D9"/>
  <bpmn:sequenceFlow id="DF12" sourceRef="D9" targetRef="D10" name="No"/>
  <bpmn:sequenceFlow id="DF13" sourceRef="D10" targetRef="D11"/>
  <bpmn:sequenceFlow id="DF14" sourceRef="D11" targetRef="D12"/>
  <bpmn:sequenceFlow id="DF15" sourceRef="D9" targetRef="D13" name="Yes"/>
  <bpmn:sequenceFlow id="DF16" sourceRef="D13" targetRef="D14"/>
  <bpmn:sequenceFlow id="DF17" sourceRef="D14" targetRef="D14J"/>
  <bpmn:sequenceFlow id="DF18" sourceRef="D17" targetRef="D14J"/>
  <bpmn:sequenceFlow id="DF19" sourceRef="D14J" targetRef="D15"/>
  <bpmn:sequenceFlow id="DF20" sourceRef="D15" targetRef="D16"/>
  <bpmn:sequenceFlow id="DF21" sourceRef="D16" targetRef="D17" name="No"/>
  <bpmn:sequenceFlow id="DF22" sourceRef="D16" targetRef="D18" name="Yes"/>
  <bpmn:sequenceFlow id="DF23" sourceRef="D18" targetRef="D19"/>
  <bpmn:sequenceFlow id="DF24" sourceRef="D19" targetRef="D20" name="Yes"/>
  <bpmn:sequenceFlow id="DF25" sourceRef="D19" targetRef="D21" name="No"/>
  <bpmn:sequenceFlow id="DF26" sourceRef="D20" targetRef="D22"/>
  <bpmn:sequenceFlow id="DF27" sourceRef="D21" targetRef="D22"/>
  <bpmn:sequenceFlow id="DF28" sourceRef="D22" targetRef="D23"/>
  <bpmn:sequenceFlow id="DF29" sourceRef="D23" targetRef="D24"/>
</bpmn:process>
 <bpmn:process id="Process_Blotter" name="Resident Blotter Intake, Official Case and Hearing Workflow" isExecutable="false">
  <bpmn:startEvent id="B0" name="Verified resident reports an incident">
   <bpmn:outgoing>BF01</bpmn:outgoing>
  </bpmn:startEvent>
  <bpmn:task id="B1" name="Enter incident date/time, place, Purok/type, narrative and optional respondent">
   <bpmn:incoming>BF01</bpmn:incoming>
   <bpmn:outgoing>BF02</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="B2" name="Create resident blotter request and reference; review Pending / SRS Ongoing">
   <bpmn:incoming>BF02</bpmn:incoming>
   <bpmn:outgoing>BF03</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="B3" name="Issue Blotter service queue ticket">
   <bpmn:incoming>BF03</bpmn:incoming>
   <bpmn:outgoing>BF04</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="B4" name="Staff or Admin reviews resident-submitted report">
   <bpmn:incoming>BF04</bpmn:incoming>
   <bpmn:outgoing>BF05</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="B5" name="Accept resident report?" gatewayDirection="Diverging">
   <bpmn:incoming>BF05</bpmn:incoming>
   <bpmn:outgoing>BF06</bpmn:outgoing>
   <bpmn:outgoing>BF09</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="B6" name="Record rejection reason; review Rejected / SRS Dismissed">
   <bpmn:incoming>BF06</bpmn:incoming>
   <bpmn:outgoing>BF07</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="B7" name="Write status history and queue resident notification">
   <bpmn:incoming>BF07</bpmn:incoming>
   <bpmn:outgoing>BF08</bpmn:outgoing>
  </bpmn:task>
  <bpmn:endEvent id="B8" name="Dismissed report remains in intake history">
   <bpmn:incoming>BF08</bpmn:incoming>
  </bpmn:endEvent>
  <bpmn:task id="B9" name="Create official case and complainant/respondent party rows">
   <bpmn:incoming>BF09</bpmn:incoming>
   <bpmn:outgoing>BF10</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="B10" name="Mark intake Accepted and link official blotter case">
   <bpmn:incoming>BF10</bpmn:incoming>
   <bpmn:outgoing>BF11</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="B11" name="Continue case management" gatewayDirection="Converging">
   <bpmn:incoming>BF11</bpmn:incoming>
   <bpmn:incoming>BF16</bpmn:incoming>
   <bpmn:incoming>BF19</bpmn:incoming>
   <bpmn:outgoing>BF12</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="B12" name="Secretary/Admin maintains Ongoing or Unresolved case status">
   <bpmn:incoming>BF12</bpmn:incoming>
   <bpmn:outgoing>BF13</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="B13" name="Schedule a hearing?" gatewayDirection="Diverging">
   <bpmn:incoming>BF13</bpmn:incoming>
   <bpmn:outgoing>BF14</bpmn:outgoing>
   <bpmn:outgoing>BF17</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="B14" name="Schedule future hearing for an Ongoing/Unresolved case">
   <bpmn:incoming>BF14</bpmn:incoming>
   <bpmn:outgoing>BF15</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="B15" name="Record hearing outcome: Held, Postponed or Cancelled">
   <bpmn:incoming>BF15</bpmn:incoming>
   <bpmn:outgoing>BF16</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="B16" name="Resolve or dismiss the case?" gatewayDirection="Diverging">
   <bpmn:incoming>BF17</bpmn:incoming>
   <bpmn:outgoing>BF18</bpmn:outgoing>
   <bpmn:outgoing>BF20</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="B17" name="Keep case open and return to case management">
   <bpmn:incoming>BF18</bpmn:incoming>
   <bpmn:outgoing>BF19</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="B18" name="Any Scheduled hearings remain?" gatewayDirection="Mixed">
   <bpmn:incoming>BF20</bpmn:incoming>
   <bpmn:incoming>BF22</bpmn:incoming>
   <bpmn:outgoing>BF21</bpmn:outgoing>
   <bpmn:outgoing>BF23</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="B19" name="Record outcomes of remaining Scheduled hearings">
   <bpmn:incoming>BF21</bpmn:incoming>
   <bpmn:outgoing>BF22</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="B20" name="Enter reason and set Resolved or Dismissed">
   <bpmn:incoming>BF23</bpmn:incoming>
   <bpmn:outgoing>BF24</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="B21" name="Archive closed case?" gatewayDirection="Diverging">
   <bpmn:incoming>BF24</bpmn:incoming>
   <bpmn:outgoing>BF25</bpmn:outgoing>
   <bpmn:outgoing>BF27</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="B22" name="Archive Resolved/Dismissed record; no hard delete">
   <bpmn:incoming>BF25</bpmn:incoming>
   <bpmn:outgoing>BF26</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="B23J" name="Continue to status update" gatewayDirection="Converging">
   <bpmn:incoming>BF26</bpmn:incoming>
   <bpmn:incoming>BF27</bpmn:incoming>
   <bpmn:outgoing>BF28</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="B23" name="Update shared status history and notify resident">
   <bpmn:incoming>BF28</bpmn:incoming>
   <bpmn:outgoing>BF29</bpmn:outgoing>
  </bpmn:task>
  <bpmn:endEvent id="B24" name="Case history retained">
   <bpmn:incoming>BF29</bpmn:incoming>
  </bpmn:endEvent>
