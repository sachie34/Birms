<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_BRMS_Verified" targetNamespace="https://sachie34.github.io/Birms/brms">
  <bpmn:process id="BRMS_Resident_Service_Process" name="BRMS Resident Service and Processing Workflow" isExecutable="false">
    <bpmn:startEvent id="Start" name="Resident starts" />
  <bpmn:task id="Verify" name="Verify Resident ID and birthdate" />
  <bpmn:exclusiveGateway id="IdentityOK" name="Identity verified?" />
  <bpmn:task id="OtpFallback" name="Name and birthdate; send one-time code" />
  <bpmn:exclusiveGateway id="OtpValid" name="OTP valid?" />
  <bpmn:endEvent id="IdentityFail" name="Identity not verified" />
  <bpmn:task id="SelectService" name="Open verified kiosk session and choose service" />
  <bpmn:exclusiveGateway id="ServiceChoice" name="Select service" />
  <bpmn:task id="DocSubmit" name="Submit document type and purpose" />
  <bpmn:task id="DocCreate" name="Create request, reference and Documents ticket" />
  <bpmn:task id="DocQueue" name="Wait in queue; Staff calls and serves / skips / cancels" />
  <bpmn:task id="DocReview" name="Secretary checks requirements" />
  <bpmn:exclusiveGateway id="ReqComplete" name="Requirements complete?" />
  <bpmn:task id="ReqIncomplete" name="Record missing requirements; keep pending" />
  <bpmn:task id="DocDecision" name="Staff / Admin makes final decision" />
  <bpmn:exclusiveGateway id="DocApproved" name="Approved?" />
  <bpmn:task id="DocReject" name="Record rejection and notify resident" />
  <bpmn:endEvent id="DocRejectEnd" name="Document request rejected" />
  <bpmn:task id="DocGenerate" name="Generate certificate from saved request data" />
  <bpmn:exclusiveGateway id="SignatureRequired" name="Chairman signature required?" />
  <bpmn:task id="ApplySignature" name="Apply stored Chairman signature snapshot" />
  <bpmn:task id="IssueCertificate" name="Issue certificate and save issuance / fee record" />
  <bpmn:task id="PrintNotify" name="Print / PDF and queue resident notification" />
  <bpmn:endEvent id="DocEnd" name="Document released" />
  <bpmn:task id="BlotterSubmit" name="Submit incident and respondent details" />
  <bpmn:task id="BlotterCreate" name="Create report reference and Blotter ticket" />
  <bpmn:task id="BlotterQueue" name="Wait in queue; Staff calls and serves / skips / cancels" />
  <bpmn:task id="BlotterReview" name="Staff reviews resident report" />
  <bpmn:exclusiveGateway id="BlotterAccepted" name="Accept report?" />
  <bpmn:task id="BlotterReject" name="Reject intake; tracker shows Dismissed" />
  <bpmn:endEvent id="BlotterRejectEnd" name="Blotter intake rejected" />
  <bpmn:task id="CreateCase" name="Create official case and party records" />
  <bpmn:task id="CaseManage" name="Manage case status; schedule hearing / summons" />
  <bpmn:task id="ArchiveCase" name="Archive resolved or dismissed case" />
  <bpmn:task id="BlotterNotify" name="Record status history and notify if configured" />
  <bpmn:endEvent id="BlotterEnd" name="Blotter case tracked" />
  <bpmn:task id="VenueSelect" name="Choose venue, purpose, date and time" />
  <bpmn:exclusiveGateway id="VenueAvailable" name="No overlapping Pending / Approved booking?" />
  <bpmn:task id="VenueRetry" name="Choose another date or time" />
  <bpmn:task id="VenueCreate" name="Create Pending reservation and Venue ticket" />
  <bpmn:task id="VenueQueue" name="Wait in queue; Staff calls and serves / skips / cancels" />
  <bpmn:task id="VenueReview" name="Staff reviews reservation" />
  <bpmn:exclusiveGateway id="VenueApproved" name="Approved?" />
  <bpmn:task id="VenueReject" name="Record rejection and notify resident" />
  <bpmn:endEvent id="VenueRejectEnd" name="Venue request rejected" />
  <bpmn:task id="VenueComplete" name="Set Approved; later mark Completed" />
  <bpmn:task id="VenueNotify" name="Record status history and notify if configured" />
  <bpmn:endEvent id="VenueEnd" name="Venue reservation completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="Verify" />
  <bpmn:sequenceFlow id="f2" sourceRef="Verify" targetRef="IdentityOK" />
  <bpmn:sequenceFlow id="f3" sourceRef="IdentityOK" targetRef="SelectService" name="Yes" />
  <bpmn:sequenceFlow id="f4" sourceRef="IdentityOK" targetRef="OtpFallback" name="No" />
  <bpmn:sequenceFlow id="f5" sourceRef="OtpFallback" targetRef="OtpValid" />
  <bpmn:sequenceFlow id="f6" sourceRef="OtpValid" targetRef="SelectService" name="Yes" />
  <bpmn:sequenceFlow id="f7" sourceRef="OtpValid" targetRef="IdentityFail" name="No" />
  <bpmn:sequenceFlow id="f8" sourceRef="SelectService" targetRef="ServiceChoice" />
  <bpmn:sequenceFlow id="f9" sourceRef="ServiceChoice" targetRef="DocSubmit" name="Documents" />
  <bpmn:sequenceFlow id="f10" sourceRef="ServiceChoice" targetRef="BlotterSubmit" name="Blotter" />
  <bpmn:sequenceFlow id="f11" sourceRef="ServiceChoice" targetRef="VenueSelect" name="Venue" />
  <bpmn:sequenceFlow id="f12" sourceRef="DocSubmit" targetRef="DocCreate" />
  <bpmn:sequenceFlow id="f13" sourceRef="DocCreate" targetRef="DocQueue" />
  <bpmn:sequenceFlow id="f14" sourceRef="DocQueue" targetRef="DocReview" />
  <bpmn:sequenceFlow id="f15" sourceRef="DocReview" targetRef="ReqComplete" />
  <bpmn:sequenceFlow id="f16" sourceRef="ReqComplete" targetRef="ReqIncomplete" name="No" />
  <bpmn:sequenceFlow id="f17" sourceRef="ReqIncomplete" targetRef="DocReview" name="Requirements supplied / recheck" />
  <bpmn:sequenceFlow id="f18" sourceRef="ReqComplete" targetRef="DocDecision" name="Yes" />
  <bpmn:sequenceFlow id="f19" sourceRef="DocDecision" targetRef="DocApproved" />
  <bpmn:sequenceFlow id="f20" sourceRef="DocApproved" targetRef="DocReject" name="No" />
  <bpmn:sequenceFlow id="f21" sourceRef="DocReject" targetRef="DocRejectEnd" />
  <bpmn:sequenceFlow id="f22" sourceRef="DocApproved" targetRef="DocGenerate" name="Yes" />
  <bpmn:sequenceFlow id="f23" sourceRef="DocGenerate" targetRef="SignatureRequired" />
  <bpmn:sequenceFlow id="f24" sourceRef="SignatureRequired" targetRef="ApplySignature" name="Yes" />
  <bpmn:sequenceFlow id="f25" sourceRef="ApplySignature" targetRef="IssueCertificate" />
  <bpmn:sequenceFlow id="f26" sourceRef="SignatureRequired" targetRef="IssueCertificate" name="No" />
  <bpmn:sequenceFlow id="f27" sourceRef="IssueCertificate" targetRef="PrintNotify" />
  <bpmn:sequenceFlow id="f28" sourceRef="PrintNotify" targetRef="DocEnd" />
  <bpmn:sequenceFlow id="f29" sourceRef="BlotterSubmit" targetRef="BlotterCreate" />
  <bpmn:sequenceFlow id="f30" sourceRef="BlotterCreate" targetRef="BlotterQueue" />
  <bpmn:sequenceFlow id="f31" sourceRef="BlotterQueue" targetRef="BlotterReview" />
  <bpmn:sequenceFlow id="f32" sourceRef="BlotterReview" targetRef="BlotterAccepted" />
  <bpmn:sequenceFlow id="f33" sourceRef="BlotterAccepted" targetRef="BlotterReject" name="No" />
  <bpmn:sequenceFlow id="f34" sourceRef="BlotterReject" targetRef="BlotterRejectEnd" />
  <bpmn:sequenceFlow id="f35" sourceRef="BlotterAccepted" targetRef="CreateCase" name="Yes" />
  <bpmn:sequenceFlow id="f36" sourceRef="CreateCase" targetRef="CaseManage" />
  <bpmn:sequenceFlow id="f37" sourceRef="CaseManage" targetRef="ArchiveCase" />
  <bpmn:sequenceFlow id="f38" sourceRef="ArchiveCase" targetRef="BlotterNotify" />
  <bpmn:sequenceFlow id="f39" sourceRef="BlotterNotify" targetRef="BlotterEnd" />
  <bpmn:sequenceFlow id="f40" sourceRef="VenueSelect" targetRef="VenueAvailable" />
  <bpmn:sequenceFlow id="f41" sourceRef="VenueAvailable" targetRef="VenueRetry" name="No" />
  <bpmn:sequenceFlow id="f42" sourceRef="VenueRetry" targetRef="VenueSelect" name="Try another slot" />
  <bpmn:sequenceFlow id="f43" sourceRef="VenueAvailable" targetRef="VenueCreate" name="Yes" />
  <bpmn:sequenceFlow id="f44" sourceRef="VenueCreate" targetRef="VenueQueue" />
  <bpmn:sequenceFlow id="f45" sourceRef="VenueQueue" targetRef="VenueReview" />
  <bpmn:sequenceFlow id="f46" sourceRef="VenueReview" targetRef="VenueApproved" />
  <bpmn:sequenceFlow id="f47" sourceRef="VenueApproved" targetRef="VenueReject" name="No" />
  <bpmn:sequenceFlow id="f48" sourceRef="VenueReject" targetRef="VenueRejectEnd" />
  <bpmn:sequenceFlow id="f49" sourceRef="VenueApproved" targetRef="VenueComplete" name="Yes" />
  <bpmn:sequenceFlow id="f50" sourceRef="VenueComplete" targetRef="VenueNotify" />
  <bpmn:sequenceFlow id="f51" sourceRef="VenueNotify" targetRef="VenueEnd" />
  </bpmn:process>
